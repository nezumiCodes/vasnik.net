<section class="cv-section" aria-labelledby="cv-experience">
  <h2 id="cv-experience">Experience</h2>
  <ol class="timeline">
    {
      roles.map((role) => (
        <li class="role">
          <h3>{role.title}</h3>
          <p class="role-meta">
            <span class="role-employer">{role.employer}</span>
            <span class="role-location"> · {role.location}</span>
          </p>
          <p class="role-dates font-mono">
            <time datetime={role.start}>{formatMonth(role.start)}</time> –{' '}
            {role.end ? <time datetime={role.end}>{formatMonth(role.end)}</time> : 'Present'}
          </p>
          <ul class="role-bullets">
            {role.bullets.map((bullet) => (
              <li>
                <Proof text={bullet} />
              </li>
            ))}
          </ul>
        </li>
      ))
    }
  </ol>
</section>
