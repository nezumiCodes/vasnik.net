---
/*
 * CV SOURCE: context/CV.md § Skills
 * Copied word for word, one array item per comma-separated skill.
 * Tool groups render in mono (proof); the Professional group renders in sans (voice).
 */
import ToolList from '@/components/ToolList.astro';

const toolGroups = [
  {
    name: 'Data Analysis',
    items: [
      'SQL (PostgreSQL, SQL Server, MySQL)',
      'Python (pandas, polars, NumPy, scikit-learn)',
      'Excel (Power Query)',
      'Alteryx',
      'OpenRefine',
      'Jupyter Notebooks',
      'statistical analysis',
      'EDA',
    ],
  },
  {
    name: 'BI & Visualisation',
    items: ['Power BI (DAX)', 'Looker / Looker Studio', 'Tableau', 'matplotlib', 'plotly'],
  },
  {
    name: 'Data Engineering & Cloud',
    items: [
      'ETL/ELT pipelines',
      'data modelling',
      'data quality and validation',
      'Google Cloud Platform (BigQuery, Cloud Functions)',
      'Microsoft Fabric',
      'Azure',
      'AWS',
      'Docker',
      'Git/GitHub',
    ],
  },
  {
    name: 'Automation & Low-code',
    items: [
      'Power Automate (cloud flows)',
      'Power Apps (canvas apps, Power Fx)',
      'SharePoint',
      'Office Scripts',
      'Make',
      'Google Apps Script',
      'Excel VBA',
      'REST APIs',
    ],
  },
];

const professional = {
  name: 'Professional',
  items: [
    'stakeholder management',
    'requirements gathering',
    'data governance and GDPR',
    'process improvement',
    'training and documentation',
  ],
};
---

<section class="cv-section mt-16" aria-labelledby="cv-skills">
  <h2 id="cv-skills">Skills</h2>
  <div class="mt-6 grid gap-x-10 gap-y-8 md:grid-cols-2">
    {
      toolGroups.map((group) => (
        <div class="skill-group">
          <h3 class="mb-3 text-[1.375rem]">{group.name}</h3>
          <ToolList tools={group.items} label={group.name} />
        </div>
      ))
    }
    <div class="skill-group">
      <h3 class="mb-3 text-[1.375rem]">{professional.name}</h3>
      <ul class="chips chips-sans" aria-label={professional.name}>
        {professional.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </div>
</section>
