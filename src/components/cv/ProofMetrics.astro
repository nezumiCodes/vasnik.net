---
/*
 * CV SOURCE: context/CV.md § Experience (Senior Data Analyst, We Are With You)
 * Home-page proof strip. Values are CV figures; labels stay close to the CV
 * wording and are captioned as results from an employed role, never as
 * freelance client results.
 */
import Metric from '@/components/Metric.astro';

const metrics = [
  { value: '60%', label: 'less manual work on recurring reports' },
  { value: '22%', label: 'fewer unnecessary FibroScan referrals' },
  { value: '3 weeks', label: 'to deliver a FibroScan tracking app, now used by all clinical staff in the service' },
];
---

<section class="proof" aria-labelledby="proof-heading">
  <h2 id="proof-heading">Track record</h2>
  <dl class="proof-metrics">
    {metrics.map((metric) => <Metric value={metric.value} label={metric.label} />)}
  </dl>
  <p class="proof-caption">Results from my role as Senior Data Analyst at We Are With You.</p>
</section>
