---
/*
 * CV SOURCE: context/CV.md § Education
 * Copied word for word. `start` / `end` are YYYY-MM for <time datetime>.
 */
import { formatMonth } from '@/lib/dates';

const degrees = [
  {
    degree: 'MSc Data Science & Artificial Intelligence',
    result: 'Distinction',
    institution: 'University of Liverpool',
    location: 'Liverpool, UK',
    start: '2023-09',
    end: '2024-09',
  },
  {
    degree: 'Integrated Master’s in Electrical & Computer Engineering',
    result: '2:1',
    institution: 'University of Patras',
    location: 'Patras, Greece',
    start: '2016-10',
    end: '2021-11',
  },
];
---

<section class="cv-section mt-16" aria-labelledby="cv-education">
  <h2 id="cv-education">Education</h2>
  <ul class="education-list mt-6 grid gap-6 md:grid-cols-2">
    {
      degrees.map((item) => (
        <li class="card">
          <h3 class="text-[1.375rem]">
            {item.degree} <span class="chip ml-1 align-middle">{item.result}</span>
          </h3>
          <p>
            {item.institution} · {item.location}
          </p>
          <p class="label">
            <time datetime={item.start}>{formatMonth(item.start)}</time> – <time datetime={item.end}>{formatMonth(item.end)}</time>
          </p>
        </li>
      ))
    }
  </ul>
</section>
