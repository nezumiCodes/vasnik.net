---
import { link } from '@/lib/link';
import { tagLabel } from '@/lib/tags';

interface Props {
  tags: readonly string[];
}

const { tags } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class="chips" aria-label="Tags">
      {tags.map((tag) => (
        <li>
          <a href={link(`/blog/tags/${tag}/`)}>{tagLabel(tag)}</a>
        </li>
      ))}
    </ul>
  )
}
