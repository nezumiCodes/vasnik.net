---
import type { CollectionEntry } from 'astro:content';
import ToolList from '@/components/ToolList.astro';
import { link } from '@/lib/link';

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { title, summary, tools, order } = service.data;
---

<article class="card">
  <p class="label">Service {String(order).padStart(2, '0')}</p>
  <h3 class="card-title">
    <a href={link(`/services/#${service.id}`)}>{title}</a>
  </h3>
  <p>{summary}</p>
  <ToolList tools={tools.slice(0, 4)} label={`Tools for ${title}`} />
  <p class="mt-auto pt-2">
    <a href={link(`/services/#${service.id}`)}>
      See the scope<span class="sr-only"> of {title}</span>
    </a>
  </p>
</article>
