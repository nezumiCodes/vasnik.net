---
import TagList from '@/components/TagList.astro';
import { formatDate, isoDate } from '@/lib/dates';
import { link } from '@/lib/link';
import type { Post } from '@/lib/posts';
import { formatReadingTime } from '@/lib/reading-time';

interface Props {
  post: Post;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel: Heading = 'h2' } = Astro.props;
const { title, description, pubDate, tags, draft } = post.data;
---

<article class="card">
  <p class="label">
    <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
    <span> · {formatReadingTime(post.body ?? '')}</span>
    {draft && <span> · Draft</span>}
  </p>
  <Heading class="card-title text-[1.625rem]">
    <a href={link(`/blog/${post.id}/`)}>{title}</a>
  </Heading>
  <p>{description}</p>
  <div class="mt-auto pt-1">
    <TagList tags={tags} />
  </div>
</article>
