---
/**
 * Render-blocking theme resolver. Must sit in <head> before the stylesheets so
 * the first paint already uses the right theme (no light flash in dark mode).
 * The code lives in src/lib/inline-scripts.mjs so its CSP hash is computed
 * from the same text in astro.config.mjs.
 */
import { THEME_SCRIPT } from '@/lib/inline-scripts.mjs';
---

<script is:inline set:html={THEME_SCRIPT} />
