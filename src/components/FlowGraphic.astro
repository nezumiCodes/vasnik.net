---
/**
 * Brand "flow" graphic: teal lines enter from the left and converge on the
 * "done" node beside the headline, with one secondary accent node.
 * Colours come from theme tokens in global.css (light: raspberry done node,
 * plum accent; dark: butter done node, raspberry accent), never from here.
 *
 * Static layer: the finished graphic (lines, four nodes, done node). It is
 * what visitors see with reduced motion, without JavaScript, or when paused.
 *
 * Motion layer (`.flow-motion`, SVG SMIL so the nodes follow the curves
 * exactly): after the lines draw in, each node travels its line on a 6.4 s
 * loop, staggered 1.6 s apart. Every arrival pops the done node, sends a pulse
 * ring out and launches a small dot along the exit line that fades away. The
 * loop runs indefinitely, so the "Pause animation" button is required
 * (WCAG 2.2.2); the choice is saved in localStorage as `motion`.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Node loop: travel for 2.4 s of a 6.4 s cycle, then wait hidden at the end.
const CYCLE = 6.4;
const STAGGER = 1.6;
const START = 1.6;
const TRAVEL_SHARE = 2.4 / CYCLE;
const runners = [
  { path: 'flow-path-1', r: 6, alt: false },
  { path: 'flow-path-2', r: 6, alt: false },
  { path: 'flow-path-3', r: 6, alt: false },
  { path: 'flow-path-4', r: 8, alt: true },
].map((runner, index) => ({ ...runner, begin: `${(START + index * STAGGER).toFixed(1)}s` }));
// Each arrival (every STAGGER seconds, from the first one) drives the done-node effects.
const firstArrival = `${(START + 2.4).toFixed(1)}s`;
const fadeIn = (0.15 / CYCLE).toFixed(3);
const fadeOutStart = (TRAVEL_SHARE - 0.15 / CYCLE).toFixed(3);
const arrive = TRAVEL_SHARE.toFixed(3);
---

<div class:list={['flow', className]}>
  <svg
    class="flow-graphic"
    viewBox="0 0 600 400"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    focusable="false"
    data-flow-graphic
  >
    <g class="flow-lines" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path id="flow-path-1" class="flow-line" pathLength="1" d="M0 60C160 60 260 190 480 200" />
      <path id="flow-path-2" class="flow-line" pathLength="1" d="M0 140C150 140 300 200 480 200" />
      <path id="flow-path-3" class="flow-line" pathLength="1" d="M0 250C170 250 300 205 480 200" />
      <path id="flow-path-4" class="flow-line" pathLength="1" d="M0 340C180 340 280 215 480 200" />
      <path class="flow-line flow-line-out" pathLength="1" d="M506 200H600" />
    </g>

    <g class="flow-nodes" stroke="currentColor" stroke-width="2">
      <circle class="flow-node" cx="217.5" cy="126.3" r="6" fill="none" />
      <circle class="flow-node" cx="113" cy="149.4" r="6" fill="none" />
      <circle class="flow-node" cx="236.3" cy="226.9" r="6" fill="none" />
      <circle class="flow-node-alt" cx="232.5" cy="275.6" r="8" />
    </g>

    <g class="flow-motion">
      {
        runners.map(({ path, r, alt, begin }) => (
          <circle class={alt ? 'flow-node-alt' : 'flow-node'} r={r} opacity="0" stroke="currentColor" stroke-width="2">
            <animateMotion
              dur={`${CYCLE}s`}
              begin={begin}
              repeatCount="indefinite"
              calcMode="spline"
              keyPoints="0;1;1"
              keyTimes={`0;${arrive};1`}
              keySplines="0.45 0 0.55 1;0 0 1 1"
            >
              <mpath href={`#${path}`} />
            </animateMotion>
            <animate
              attributeName="opacity"
              dur={`${CYCLE}s`}
              begin={begin}
              repeatCount="indefinite"
              values="0;1;1;0;0"
              keyTimes={`0;${fadeIn};${fadeOutStart};${arrive};1`}
            />
          </circle>
        ))
      }
      <circle class="flow-pulse-ring" cx="480" cy="200" r="24" fill="none" stroke-width="2" opacity="0">
        <animate attributeName="r" dur={`${STAGGER}s`} begin={firstArrival} repeatCount="indefinite" values="24;40;40" keyTimes="0;0.6;1" />
        <animate attributeName="opacity" dur={`${STAGGER}s`} begin={firstArrival} repeatCount="indefinite" values="0.9;0;0" keyTimes="0;0.6;1" />
      </circle>
      <circle class="flow-exit" cy="200" r="4" opacity="0">
        <animate attributeName="cx" dur={`${STAGGER}s`} begin={firstArrival} repeatCount="indefinite" values="506;598;598" keyTimes="0;0.65;1" calcMode="spline" keySplines="0.2 0 0.4 1;0 0 1 1" />
        <animate attributeName="opacity" dur={`${STAGGER}s`} begin={firstArrival} repeatCount="indefinite" values="0;1;0;0" keyTimes="0;0.08;0.65;1" />
      </circle>
    </g>

    <circle class="flow-done-ring" cx="480" cy="200" r="24" fill="none" stroke="currentColor" stroke-width="2" />
    <circle class="flow-done" cx="480" cy="200" r="14" />
    <circle class="flow-motion flow-done" cx="480" cy="200" r="14">
      <animate attributeName="r" dur={`${STAGGER}s`} begin={firstArrival} repeatCount="indefinite" values="14;17;14;14" keyTimes="0;0.12;0.35;1" />
    </circle>
  </svg>
  <button class="motion-toggle" type="button" data-motion-toggle>
    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true">
      <path class="motion-icon-pause" d="M2.5 1.5h2.25v9H2.5zM7.25 1.5H9.5v9H7.25z" fill="currentColor" />
      <path class="motion-icon-play" d="M3 1.25v9.5L10.5 6z" fill="currentColor" />
    </svg>
    <span data-motion-label>Pause animation</span>
  </button>
</div>

<script>
  const STORAGE_KEY = 'motion';
  const root = document.documentElement;
  const graphics = document.querySelectorAll<SVGSVGElement>('[data-flow-graphic]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-motion-toggle]');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  // The motion layer is hidden by CSS when paused or under reduced motion;
  // freezing the SMIL timeline as well stops the work behind it.
  function syncTimeline(): void {
    const frozen = root.dataset.motion === 'paused' || reducedMotion.matches;
    graphics.forEach((svg) => (frozen ? svg.pauseAnimations() : svg.unpauseAnimations()));
  }

  function setPaused(paused: boolean): void {
    if (paused) root.dataset.motion = 'paused';
    else delete root.dataset.motion;
    buttons.forEach((button) => {
      const label = button.querySelector('[data-motion-label]');
      if (label) label.textContent = paused ? 'Play animation' : 'Pause animation';
    });
    syncTimeline();
  }

  let saved: string | null = null;
  try {
    saved = localStorage.getItem(STORAGE_KEY);
  } catch {
    // Storage blocked: the animation runs and the button still works per page view.
  }
  setPaused(saved === 'paused');
  root.dataset.motionControl = '';
  reducedMotion.addEventListener('change', syncTimeline);

  buttons.forEach((button) =>
    button.addEventListener('click', () => {
      const paused = root.dataset.motion !== 'paused';
      setPaused(paused);
      try {
        if (paused) localStorage.setItem(STORAGE_KEY, 'paused');
        else localStorage.removeItem(STORAGE_KEY);
      } catch {
        // Storage blocked: the choice lasts for this page view only.
      }
    }),
  );
</script>

<style>
  .flow {
    display: grid;
    justify-items: end;
  }

  .flow-graphic {
    width: 100%;
    color: var(--c-flow);
  }

  /* Shown only when there is motion to pause and the script is running. */
  .motion-toggle {
    display: none;
    min-height: 2.75rem;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.25rem;
    border: 0;
    background: transparent;
    color: var(--c-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    cursor: pointer;

    &:hover {
      color: var(--c-heading);
      text-decoration: underline;
    }
  }

  .motion-icon-play,
  :global([data-motion='paused']) .motion-icon-pause {
    display: none;
  }

  :global([data-motion='paused']) .motion-icon-play {
    display: inline;
  }

  .flow-node {
    fill: var(--c-bg);
  }

  .flow-node-alt {
    fill: var(--c-node-alt);
    stroke: var(--c-node-alt);
  }

  .flow-done,
  .flow-exit {
    fill: var(--c-node-done);
  }

  .flow-done-ring,
  .flow-pulse-ring {
    stroke: var(--c-node-done);
  }

  .flow-done,
  .flow-done-ring,
  .flow-nodes > * {
    transform-box: fill-box;
    transform-origin: center;
  }

  /* Motion layer: off unless motion is allowed, the script runs and not paused. */
  .flow-motion {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .flow-line {
      stroke-dasharray: 1 1;
      stroke-dashoffset: 1;
      animation: flow-draw 1.2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    }

    .flow-line:nth-child(2) {
      animation-delay: 0.1s;
    }

    .flow-line:nth-child(3) {
      animation-delay: 0.2s;
    }

    .flow-line:nth-child(4) {
      animation-delay: 0.3s;
    }

    .flow-line-out {
      animation-duration: 0.4s;
      animation-delay: 1.4s;
    }

    .flow-nodes > * {
      opacity: 0;
      animation: flow-appear 0.4s ease-out 0.8s forwards;
    }

    .flow-done {
      animation: flow-pop 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 1.1s both;
    }

    /* Without JavaScript: two pulses, at rest by about 4.6 s, no control needed. */
    .flow-done-ring {
      animation: flow-pulse 1.6s ease-in-out 1.4s 2 both;
    }

    /* With the pause control: nodes travel instead of sitting still. */
    :global(:root[data-motion-control]:not([data-motion='paused'])) .flow-motion {
      display: inline;
    }

    :global(:root[data-motion-control]:not([data-motion='paused'])) .flow-nodes {
      display: none;
    }

    :global(:root[data-motion-control]:not([data-motion='paused'])) .flow-done-ring {
      animation: none;
    }

    :global([data-motion-control]) .motion-toggle {
      display: inline-flex;
    }
  }

  @keyframes flow-draw {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes flow-appear {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes flow-pop {
    from {
      transform: scale(0);
    }
    to {
      transform: scale(1);
    }
  }

  @keyframes flow-pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.25;
      transform: scale(1.3);
    }
  }
</style>
