---
import { FEATURES } from '@/config';
import { link } from '@/lib/link';

const meanwhile = FEATURES.services
  ? { href: '/services/', label: 'services' }
  : { href: '/experience/', label: 'experience' };
---

<div class="empty-state">
  <p class="font-serif text-[1.5rem] leading-tight text-heading">First articles coming soon.</p>
  <p>
    Follow along with the <a href={`${link('/')}rss.xml`}>RSS feed</a>, or see my{' '}
    <a href={link(meanwhile.href)}>{meanwhile.label}</a> in the meantime.
  </p>
</div>
