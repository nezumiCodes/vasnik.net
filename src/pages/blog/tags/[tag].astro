---
import type { GetStaticPaths } from 'astro';
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { link } from '@/lib/link';
import { getPublishedPosts, type Post } from '@/lib/posts';
import { countTags, tagLabel } from '@/lib/tags';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return countTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
const label = tagLabel(tag);
---

<BaseLayout title={`Posts tagged ${label}`} description={`Blog posts about ${label}.`}>
  <div class="page-wrap py-14">
    <header class="mb-10">
      <p class="label"><a class="text-label" href={link('/blog/tags/')}>All tags</a></p>
      <h1 class="mt-2">
        Tagged <em>{label}</em>
      </h1>
      <p class="mt-4 font-mono text-sm text-muted">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </header>

    <div class="grid gap-6 md:grid-cols-2">
      {posts.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</BaseLayout>
