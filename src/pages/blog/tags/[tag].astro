---
import type { GetStaticPaths } from 'astro';
import PostCard from '@/components/PostCard.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { link } from '@/lib/link';
import { getPublishedPosts, type Post } from '@/lib/posts';
import { countTags, tagLabel } from '@/lib/tags';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return countTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}) satisfies GetStaticPaths;

interface Props {
  tag: string;
  posts: Post[];
}

const { tag, posts } = Astro.props;
const label = tagLabel(tag);
---

<BaseLayout title={`Posts tagged ${label}`} description={`Blog posts about ${label}.`}>
  <header class="page-header">
    <p class="font-mono"><a href={link('/blog/tags/')}>All tags</a></p>
    <h1>
      Tagged <span class="font-mono">{label}</span>
    </h1>
    <p class="font-mono">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </header>

  <div class="post-list">
    {posts.map((post) => <PostCard post={post} />)}
  </div>
</BaseLayout>
