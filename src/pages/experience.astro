---
import Certifications from '@/components/cv/Certifications.astro';
import Education from '@/components/cv/Education.astro';
import Experience from '@/components/cv/Experience.astro';
import Languages from '@/components/cv/Languages.astro';
import Skills from '@/components/cv/Skills.astro';
import Summary from '@/components/cv/Summary.astro';
import { CONTACT } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { link } from '@/lib/link';
---

<BaseLayout
  title="Experience"
  description="Experience, skills and education of Vasiliki (Celia) Nikolaidi, data and automation specialist: SQL, Python, Power BI, Power Platform and Google Cloud Platform."
>
  <div class="cv">
    <header class="page-header">
      <h1>Experience</h1>
      <p class="page-actions">
        <a href={link('/contact/')}>Get in touch</a>
        <a href={CONTACT.linkedin} rel="me noopener">LinkedIn profile</a>
      </p>
    </header>
    <Summary />
    <Experience />
    <Education />
    <Skills />
    <Certifications />
    <Languages />
  </div>
</BaseLayout>
