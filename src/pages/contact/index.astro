---
import { CONTACT, FEATURES } from '@/config';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getServices } from '@/lib/services';

const services = FEATURES.services ? await getServices() : [];
const formAction = CONTACT.formspreeFormId ? `https://formspree.io/f/${CONTACT.formspreeFormId}` : null;
---

<BaseLayout title="Contact" description="Get in touch about reporting automation, dashboards, low-code apps or data audits.">
  <div class="page-wrap max-w-[42rem] py-14">
    <header>
      <p class="label">Contact</p>
      <h1 class="mt-2">Get in touch</h1>
      <p class="lead mt-6">Tell me what’s slowing your team down. I’ll reply with whether and how it can be automated.</p>
    </header>

    {
      formAction ? (
        <form class="mt-10 grid gap-5" action={formAction} method="POST">
          <input type="hidden" name="_subject" value="New enquiry from vasnik.net" />
          <div style="display:none" aria-hidden="true">
            <label for="contact-gotcha">Leave this field empty</label>
            <input id="contact-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <p class="field">
            <label for="contact-name">Name</label>
            <input id="contact-name" name="name" type="text" autocomplete="name" required />
          </p>
          <p class="field">
            <label for="contact-email">Email</label>
            <input id="contact-email" name="email" type="email" autocomplete="email" required />
          </p>
          <p class="field">
            <label for="contact-organisation">
              Organisation <span class="field-optional">(optional)</span>
            </label>
            <input id="contact-organisation" name="organisation" type="text" autocomplete="organization" />
          </p>
          {services.length > 0 && (
            <p class="field">
              <label for="contact-service">What can I help with?</label>
              <select id="contact-service" name="service">
                {services.map((service) => (
                  <option value={service.data.title}>{service.data.title}</option>
                ))}
                <option value="Something else">Something else</option>
              </select>
            </p>
          )}
          <p class="field">
            <label for="contact-message">Message</label>
            <textarea id="contact-message" name="message" rows="6" required />
          </p>
          <p class="text-sm text-muted">Your message is sent through Formspree and used only to reply to you.</p>
          <p>
            <button class="button" type="submit">
              Send message
            </button>
          </p>
        </form>
      ) : (
        <p class="empty-state mt-10">The contact form is coming soon.</p>
      )
    }

    <p class="mt-8">
      You can also message me on <a href={CONTACT.linkedin} rel="me noopener">LinkedIn</a>.
    </p>
  </div>
</BaseLayout>
