---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { link } from '@/lib/link';
---

<BaseLayout title="Message sent" description="Thanks for getting in touch." noindex>
  <div class="page-wrap max-w-[42rem] py-20">
    <header>
      <p class="label">Message sent</p>
      <h1 class="mt-2">Thanks, your message is <em>on its way</em></h1>
      <p class="lead mt-6">I'll reply as soon as I can.</p>
    </header>
    <p class="mt-8">
      In the meantime, see the <a href={link('/experience/')}>experience</a> behind the{' '}
      <a href={link('/services/')}>services</a>.
    </p>
  </div>
</BaseLayout>
