---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { link } from '@/lib/link';
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <div class="page-wrap max-w-[42rem] py-20">
    <header>
      <p class="label">Error 404</p>
      <h1 class="mt-2">Page not found</h1>
      <p class="lead mt-6">The page you're looking for has moved or never existed.</p>
    </header>
    <ul class="node-list mt-8">
      <li><a href={link('/')}>Home</a></li>
      <li><a href={link('/services/')}>Services</a></li>
      <li><a href={link('/experience/')}>Experience</a></li>
      <li><a href={link('/blog/')}>Blog</a></li>
    </ul>
  </div>
</BaseLayout>
