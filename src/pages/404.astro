---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { link } from '@/lib/link';
---

<BaseLayout title="Page not found" description="This page doesn't exist." noindex>
  <header class="page-header">
    <p class="font-mono">404</p>
    <h1>Page not found</h1>
    <p class="lead">The page you're looking for has moved or never existed.</p>
  </header>
  <ul>
    <li><a href={link('/')}>Home</a></li>
    <li><a href={link('/services/')}>Services</a></li>
    <li><a href={link('/experience/')}>Experience</a></li>
    <li><a href={link('/blog/')}>Blog</a></li>
  </ul>
</BaseLayout>
